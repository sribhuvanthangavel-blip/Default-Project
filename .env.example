# ---------------------------------------------------------------------------
# Jishnu's Dentistry — environment variables
# Copy to `.env.local` for development. Never commit `.env.local`.
# All values below are placeholders.
# ---------------------------------------------------------------------------

# Public site URL (used for canonical URLs, sitemap, Open Graph, auth redirects).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project settings — Dashboard → Project Settings → API.
# The anon key is public by design; RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Used narrowly for duplicate-submission checks and admin
# provisioning scripts. NEVER prefix with NEXT_PUBLIC_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Clinic timezone, used to decide what "today" means for booking validation.
# Confirm with the clinic before going live.
CLINIC_TIMEZONE=Asia/Kolkata

# Optional transactional email (Resend). When unset, notifications are skipped
# and the request is still stored in the database.
RESEND_API_KEY=
EMAIL_FROM=Jishnu's Dentistry <appointments@example.com>
ADMIN_NOTIFICATION_EMAIL=

# Optional: enables the "rate limit" warning-free path when set to a random
# 32+ character secret. Used to hash visitor IPs for in-memory rate limiting.
RATE_LIMIT_SALT=replace-with-a-long-random-string
