# Normalise line endings in the repository to LF so the same content is used on
# Windows, macOS, Linux and Vercel.
* text=auto eol=lf

# Binary assets must never be converted.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary

# Generated lockfile: keep it as-is.
package-lock.json text eol=lf
